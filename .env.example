# Optional build-time settings. Every value has a default in the code, so the site builds without
# this file. To use one locally, copy this file to .env.local; on Vercel, add it under
# Project > Settings > Environment Variables, then redeploy.

# Public address of the site (no trailing slash). Used for the canonical URL, sitemap, OG image
# and the resume header. Default: https://kadwasra.vercel.app (src/content/profile.ts)
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key for the contact form (public by design).
# Default: the key in src/content/transmission.ts
NEXT_PUBLIC_WEB3FORMS_KEY=
